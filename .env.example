# .env.example

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DB_NAME=trading_db
DB_USER=trading_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Database MongoDB Settings
MONGO_URI=mongodb://your_mongodb_user:your_mongodb_password@your_mongodb_host:27017/
MONGO_DB_NAME=trading_db
MONGO_COLLECTION=trades


# MT5 Connection Settings
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=your-mt5-account-number
MT5_PASSWORD=your-mt5-password
MT5_SERVER=your-mt5-server
MT5_TIMEOUT=60000

# Risk Management Settings
MAX_DAILY_LOSS=-1000
MAX_POSITION_SIZE=1.0
MAX_OPEN_POSITIONS=5
DEFAULT_RISK_PER_TRADE=0.02

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/trading.log
MAX_LOG_SIZE=10485760  # 10MB
BACKUP_COUNT=5

# Email Settings (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False